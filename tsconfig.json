{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "shared/**/*",
    "tests/**/*",
    "electron.vite.config.ts",
    "scripts/**/*"
  ]
}
