{
  "name": "electron-file-browser",
  "version": "1.0.0",
  "private": true,
  "description": "A simple Electron file browser built with Vue, TypeScript, Vite and Bootstrap",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
